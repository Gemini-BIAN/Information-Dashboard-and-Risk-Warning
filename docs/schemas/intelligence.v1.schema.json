{
  "$defs": {
    "Applicability": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "unknown",
          "enum": [
            "proposal",
            "adopted",
            "effective",
            "repealed",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "legal_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legal Identifier"
        },
        "jurisdictions": {
          "items": {
            "type": "string"
          },
          "title": "Jurisdictions",
          "type": "array"
        },
        "products_in_scope": {
          "items": {
            "type": "string"
          },
          "title": "Products In Scope",
          "type": "array"
        },
        "products_out_of_scope": {
          "items": {
            "type": "string"
          },
          "title": "Products Out Of Scope",
          "type": "array"
        },
        "electrolyte_applicability": {
          "default": "unknown",
          "enum": [
            "direct",
            "indirect",
            "not_applicable",
            "unknown"
          ],
          "title": "Electrolyte Applicability",
          "type": "string"
        },
        "effective_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective At"
        },
        "expiry_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expiry At"
        },
        "repeal_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repeal At"
        },
        "date_precision": {
          "default": "unknown",
          "enum": [
            "instant",
            "date_only",
            "unknown"
          ],
          "title": "Date Precision",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "applicability_note_zh": {
          "title": "Applicability Note Zh",
          "type": "string"
        }
      },
      "required": [
        "applicability_note_zh"
      ],
      "title": "Applicability",
      "type": "object"
    },
    "Domain": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F"
      ],
      "title": "Domain",
      "type": "string"
    },
    "EvidenceSnippet": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "quote": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "raw_revision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Revision Id"
        },
        "raw_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Sha256"
        },
        "capture_mode": {
          "enum": [
            "live",
            "demo",
            "fixture"
          ],
          "title": "Capture Mode",
          "type": "string"
        },
        "precision_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision Note"
        }
      },
      "required": [
        "evidence_id",
        "source_url",
        "quote",
        "locator",
        "capture_mode"
      ],
      "title": "EvidenceSnippet",
      "type": "object"
    },
    "FactualStatement": {
      "additionalProperties": false,
      "properties": {
        "text_zh": {
          "title": "Text Zh",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "text_zh",
        "evidence_ids"
      ],
      "title": "FactualStatement",
      "type": "object"
    },
    "GenericAsset": {
      "additionalProperties": false,
      "properties": {
        "asset_type": {
          "enum": [
            "country",
            "port",
            "lane",
            "facility",
            "product"
          ],
          "title": "Asset Type",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "public_generic_only": {
          "const": true,
          "default": true,
          "title": "Public Generic Only",
          "type": "boolean"
        },
        "association": {
          "default": "candidate_unverified",
          "enum": [
            "explicit",
            "candidate_unverified"
          ],
          "title": "Association",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "asset_type",
        "label",
        "evidence_ids"
      ],
      "title": "GenericAsset",
      "type": "object"
    },
    "Inference": {
      "additionalProperties": false,
      "properties": {
        "text_zh": {
          "title": "Text Zh",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "certainty": {
          "const": "hypothesis",
          "default": "hypothesis",
          "title": "Certainty",
          "type": "string"
        }
      },
      "required": [
        "text_zh",
        "evidence_ids"
      ],
      "title": "Inference",
      "type": "object"
    },
    "Relevance": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "default": "unknown",
          "enum": [
            "relevant",
            "possibly_relevant",
            "excluded",
            "unknown"
          ],
          "title": "Decision",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "reasons_zh": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons Zh",
          "type": "array"
        },
        "explicit_supply_chain_link": {
          "default": false,
          "title": "Explicit Supply Chain Link",
          "type": "boolean"
        },
        "assessed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessed At"
        }
      },
      "required": [
        "reason_codes",
        "reasons_zh"
      ],
      "title": "Relevance",
      "type": "object"
    },
    "SuggestedAction": {
      "additionalProperties": false,
      "properties": {
        "text_zh": {
          "title": "Text Zh",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "in_review",
            "done",
            "dismissed"
          ],
          "title": "Status",
          "type": "string"
        },
        "verification_question": {
          "title": "Verification Question",
          "type": "string"
        }
      },
      "required": [
        "text_zh",
        "evidence_ids",
        "verification_question"
      ],
      "title": "SuggestedAction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "data_mode": {
      "enum": [
        "live",
        "demo",
        "fixture"
      ],
      "title": "Data Mode",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_name": {
      "title": "Source Name",
      "type": "string"
    },
    "source_type": {
      "enum": [
        "official",
