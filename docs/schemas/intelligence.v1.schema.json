    "status": {
      "default": "metadata_only",
      "enum": [
        "metadata_only",
        "pending_analysis",
        "analyzed",
        "reviewed",
        "excluded"
      ],
      "title": "Status",
      "type": "string"
    },
    "dedup_key": {
      "title": "Dedup Key",
      "type": "string"
    },
    "update_version": {
      "minimum": 1,
      "title": "Update Version",
      "type": "integer"
    },
    "previous_record_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Record Ref"
    },
    "quality_flags": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Quality Flags",
      "type": "array"
    }
