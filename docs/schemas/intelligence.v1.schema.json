      "type": "string"
    },
    "countries": {
      "items": {
        "type": "string"
      },
      "title": "Countries",
      "type": "array"
    },
    "ports": {
      "items": {
        "type": "string"
      },
      "title": "Ports",
      "type": "array"
    },
    "routes": {
      "items": {
        "type": "string"
      },
      "title": "Routes",
      "type": "array"
    },
    "entities": {
      "items": {
        "type": "string"
      },
      "title": "Entities",
      "type": "array"
    },
    "products": {
      "items": {
        "type": "string"
      },
      "title": "Products",
      "type": "array"
    },
