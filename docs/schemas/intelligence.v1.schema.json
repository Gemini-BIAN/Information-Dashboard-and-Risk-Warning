  "required": [
    "record_id",
    "data_mode",
    "source_id",
    "source_name",
    "source_type",
    "organization_id",
    "canonical_url",
    "permitted_method",
    "reuse_audit_ref",
    "original_title",
    "fetched_at",
    "last_verified_at",
    "severity_reasons",
    "business_relevance",
    "dedup_key",
    "update_version",
    "quality_flags"
  ],
  "title": "IntelligenceRecord",
  "type": "object"
}
