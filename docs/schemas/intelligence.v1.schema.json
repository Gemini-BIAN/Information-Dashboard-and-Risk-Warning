    "currentness_checked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currentness Checked At"
    },
    "business_relevance": {
      "$ref": "#/$defs/Relevance"
    },
    "evidence_snippets": {
      "items": {
        "$ref": "#/$defs/EvidenceSnippet"
      },
      "title": "Evidence Snippets",
      "type": "array"
    },
    "factual_summary_zh": {
      "items": {
        "$ref": "#/$defs/FactualStatement"
      },
      "title": "Factual Summary Zh",
      "type": "array"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/Inference"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "potential_impacts": {
      "items": {
        "$ref": "#/$defs/Inference"
      },
      "title": "Potential Impacts",
      "type": "array"
    },
    "suggested_checks_actions": {
      "items": {
        "$ref": "#/$defs/SuggestedAction"
      },
      "title": "Suggested Checks Actions",
      "type": "array"
    },
    "generic_assets": {
      "items": {
        "$ref": "#/$defs/GenericAsset"
      },
      "title": "Generic Assets",
      "type": "array"
    },
    "applicability": {
      "anyOf": [
        {
          "$ref": "#/$defs/Applicability"
        },
        {
          "type": "null"
        }
      ],
      "default": null
