# All runtime artifacts stay local; do not commit company data.
SCM_DATABASE_URL=sqlite:///runtime/scm.db
SCM_LLM_PROVIDER=none
# Optional OpenAI-compatible HTTPS endpoint. No paid service is required.
SCM_LLM_BASE_URL=https://api.openai.com/v1
SCM_LLM_MODEL=
SCM_LLM_API_KEY=
SCM_TIMEZONE=Asia/Shanghai

# New unified platform only; does not replace original or paused regulatory DB.
SCM_PLATFORM_DATABASE_URL=sqlite:///runtime/platform/platform.db
